{
    "env": {
      "browser": true,
      "es2021": true
    },
    "extends": "eslint:recommended",
    "parserOptions": {
      "ecmaVersion": 12,
      "sourceType": "script"
    },
    "rules": {
      "no-unused-vars": "warn",
      "no-undef": "error",
      "no-extra-semi": "warn",
      "no-duplicate-imports": "error"
    },
    "globals": {
      "Game": "readonly",
      "UI": "readonly",
      "RECRUIT_POOL": "readonly",
      "RANDOM_EVENT_POOL": "readonly",
      "CONSTANTS": "readonly",
      "GAME": "readonly"
    }
  }